/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "repair-bot-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-05-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// ── D1 Database ────────────────────────────────────────────────────────────
  // Run: npx wrangler d1 create repair-bot-db
  // Paste the database_id from the output below
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repair-bot-db",
      "database_id": "a14d236e-5ae1-4b88-a352-d31de0c8feca"
    }
  ],

  // ── Cron trigger — uncomment after bot is stable ───────────────────────────
  // "triggers": {
  //   "crons": ["0 13 * * *"]
  // }


	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	"vars": {
    // Secrets are managed directly in Cloudflare dashboard (Workers & Pages >
    // repair-bot-worker > Settings > Variables and Secrets), NOT here —
    // a var declared live in this block gets reset to this file's value
    // on every `wrangler deploy`, silently overwriting any dashboard edit.

    	"BOT_ENABLED": "true",
		"TEST_ALLOWLIST": "601123139568,2347015759242,601153696696,601115420094",
		//"DELISTED_NUMBERS": "", already deployed as secret, so not needed here
		"MUTE_WINDOW_MINUTES": "1", // default is 75 for now, just testing with 1 minute
		"LLM_PROVIDER": "claude",
		"GEMINI_MODEL": "gemini-3.1-flash-lite",
		"CLAUDE_MODEL": "claude-sonnet-5",
		"GOOGLE_SHEET_ID": "1nivMpkhXgaXbOGkMYLq2E9aj20L6UO1a27lXc0vYYrA",
		"MESSAGE_DEBOUNCE_MS": "4000",
		"HISTORY_MESSAGE_LIMIT": "32"
	}
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
